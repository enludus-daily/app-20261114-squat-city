        }
      }
    },
    "2 秒かけて下ろし、1 秒で立つ。立ったら 1 ブロック": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower for 2 sec, stand in 1. Each stand places a block"
          }
        }
      }
    },
    "2 秒かけて下ろすと、\n頑丈なブロック": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower for 2 seconds\nfor a solid block"
          }
        }
      }
    },
